{
  "name": "com-nonuqu-svn",
  "version": "0.4.0",
  "private": true,
  "license": "MIT",
  "main": "dist-electron/main/electron/main.js",
  "type": "module",
  "scripts": {
    "build": "electron-vite build --config electron.vite.config.ts && node -e \"require('fs').copyFileSync('electron/package.json','dist-electron/main/electron/package.json')\"",
    "build:shell-extension": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-shell-extension.ps1",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "icon": "node scripts/generate-icon.cjs",
    "lint": "biome lint .",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "dist": "npm run build:shell-extension && npm run build && electron-builder --config electron-builder.config.json",
    "dev": "electron-vite dev --config electron.vite.config.ts",
    "dev:clean": "node scripts/dev-clean.mjs && npm run dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.4.0",
    "playwright": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.0.0",
    "vite": "^7.1.12",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@headless-tree/core": "^1.7.0",
    "@headless-tree/react": "^1.7.0",
    "highlight.js": "^11.12.0"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,css}": "biome check --write",
    "{electron.vite.config.ts,vitest.config.ts}": "biome check --write"
  }
}
